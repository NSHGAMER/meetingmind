# =================================================================
# MeetingMind Environment Configuration Template
# =================================================================
# Copy this file to:
#   - backend/.env  (for backend development)
#   - frontend/.env (for frontend development: set VITE_API_URL)
# =================================================================

# ---------- Backend (backend/.env) ----------
DATABASE_URL=sqlite:///./meetingmind.db
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Hindsight Memory (Vectorize.io)
# Hindsight Cloud: https://api.hindsight.vectorize.io (get key from https://ui.hindsight.vectorize.io)
# Self-hosted: http://localhost:8888 (no key needed)
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_PREFIX=meetingmind

# LLM Provider (Groq / OpenAI-compatible endpoint)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b

MAX_UPLOAD_MB=2

# ---------- Frontend (frontend/.env) ----------
VITE_API_URL=http://localhost:8000
