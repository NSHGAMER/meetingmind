# =================================================================
# MeetingMind Environment Configuration Template
# =================================================================

# ---------- Database (Supabase PostgreSQL / SQLite) ----------
# Local dev: sqlite:///./meetingmind.db
# Production Supabase PostgreSQL:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./meetingmind.db

# ---------- Authentication ----------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ---------- Hindsight Memory (Vectorize.io) ----------
# Hindsight Cloud: https://api.hindsight.vectorize.io (get key from https://ui.hindsight.vectorize.io)
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_PREFIX=meetingmind

# ---------- LLM Provider (Groq) ----------
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b

MAX_UPLOAD_MB=2

# ---------- Frontend (Optional in Vercel same-origin) ----------
# VITE_API_URL=http://localhost:8000
